FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN apk add --no-cache \
    ca-certificates \
    helm \
    kubectl \
    && addgroup -S lfk \
    && adduser -S lfk -G lfk

COPY lfk /usr/local/bin/lfk

ENV TERM=xterm-256color
ENV COLORTERM=truecolor

USER lfk

ENTRYPOINT ["lfk"]
